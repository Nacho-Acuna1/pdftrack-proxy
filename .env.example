# ==============================================================================
# PDFtrack - pdftrack-proxy Environment Configuration
# ==============================================================================
# Single entry point reverse proxy based on Traefik v3.
# All variables are interpolated into static and dynamic templates at startup.
# ==============================================================================

# Upstream pdftrack-extractor hostname and internal port
EXTRACTOR_HOST=extractor
EXTRACTOR_PORT=8000

# Upstream pdftrack-documents hostname and internal port
DOCUMENTS_HOST=documents
DOCUMENTS_PORT=8001

# Public entrypoint port exposed by Traefik (HTTP)
PUBLIC_PORT=80

# Internal health check port (Traefik ping endpoint, not exposed to public traffic)
INTERNAL_PING_PORT=8082

# Maximum request body size in bytes: 55 MiB = 57671680 bytes
MAX_REQUEST_BODY_BYTES=57671680

# Request body in-memory buffer threshold in bytes: 2 MiB = 2097152 bytes
# Bodies exceeding this threshold are written to temporary disk files, protecting container RAM.
MEM_REQUEST_BODY_BYTES=2097152

# Upstream read timeout (maximum duration for reading upstream response)
PROXY_READ_TIMEOUT=35s

# Upstream connection timeout (maximum duration for establishing TCP connection to upstream)
PROXY_CONNECT_TIMEOUT=5s

# Upstream send/write timeout (maximum duration for transmitting request to upstream)
PROXY_SEND_TIMEOUT=35s

# Graceful shutdown timeout (draining in-flight requests before SIGKILL)
PROXY_GRACE_TIMEOUT=30s

# Logging level for Traefik events (DEBUG, INFO, WARN, ERROR)
TRAEFIK_LOG_LEVEL=WARN
